# PPA custom-harness appbook, Part 3. Copy to .env and fill in what you need.
# Every value is optional: with nothing set the appbook runs on the practice
# workspace, the local store and the scripted responder. Names only; no values.

# Models (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PPA_EFFORT=
TYPESAFE_API_KEY=
PPA_SYSTEM_ONE=
TAVILY_API_KEY=

# Which responder and which store
PPA_RESPONDER=
PPA_SUBSTRATE=

# Where the appbook and its workspace gateway listen
HOST=
PORT=
PPA_MCP_PORT=
PPA_MCP_TOKEN=

# Prices used by the context and cost ledger, USD per million tokens
PPA_PRICE_FRESH_INPUT=
PPA_PRICE_CACHE_WRITE=
PPA_PRICE_CACHE_READ=
PPA_PRICE_OUTPUT=

# Oracle AI Database, when the appbook keeps its state there (optional)
PPA_APPBOOK_ORA_DSN=
PPA_APPBOOK_ORA_USER=
PPA_APPBOOK_ORA_PWD=
ORACLE_ADMIN_PASSWORD=

# The notebook's schema, for the read-only window (optional)
PPA_ORA_DSN=
PPA_ORA_USER=
PPA_ORA_PWD=

# Tracing (optional)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
